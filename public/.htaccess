<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ─── Subdomain routing (Wildcard mapping) ────────────────────
  # Catch any requests to slug.drape.digital (except www.drape.digital)
  RewriteCond %{HTTP_HOST} ^([a-z0-9\-]+)\.drape\.digital$ [NC]
  RewriteCond %{HTTP_HOST} !^www\.drape\.digital$ [NC]
  # Prevent infinite loops if we are already rewriting to the slug dir
  RewriteCond %{REQUEST_URI} !^/%1/
  # Transparently route to the folder matching the slug
  RewriteRule ^(.*)$ /%1/$1 [L]

  # ─── API rewrites ────────────────────────────────────────────
  RewriteRule ^api/contact$ php/contact.php [L]
  RewriteRule ^api/quote$ php/quote.php [L]

  # ─── SPA routing ─────────────────────────────────────────────
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ─── Cache Control ─────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  # Favicons & images: cache 1 month
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  # Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  # CSS & JS (hashed filenames from Vite)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Web manifest
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ─── Security Headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── Compression ───────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
